# Workflow-owned static policy. This file contains two fragments inserted into
# config.toml.seed; it does not contain user model, security, UI, history,
# host paths, project trust, MCP, plugin marketplace state, or hook hashes.
# pennix-workflow-lifecycle:install-root:begin
# Root-level Codex settings remain user-owned.
# pennix-workflow-lifecycle:install-root:end

# pennix-workflow-lifecycle:install-features:begin
remote_compaction_v2 = true
hooks = true
goals = true
memories = false

[features.code_mode]
direct_only_tool_namespaces = ["mcp__fastctx"]

[agents]
enabled = false
# pennix-workflow-lifecycle:install-features:end
