# Pennix Codex seed configuration. Only seed-owned fields appear here.
# pennix-workflow-lifecycle:seed-config
cli_auth_credentials_store = "file"
model_provider = "OpenAI"

# pennix-workflow-lifecycle:install-root:begin
# The installation phase materializes portable root-level static settings here.
# pennix-workflow-lifecycle:install-root:end

[model_providers.OpenAI]
name = "OpenAI"
base_url = "{{PENNIX_BASE_URL}}"
wire_api = "responses"
requires_openai_auth = true

[features]
default_mode_request_user_input = true

# pennix-workflow-lifecycle:install-features:begin
# The installation phase materializes Pennix feature settings here.
# pennix-workflow-lifecycle:install-features:end
